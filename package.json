{
  "name": "inventory-stock-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory Stock Management System - Pabrik Percetakan Karton",
  "scripts": {
    "install:all": "npm install && npm install --prefix client --include=dev",
    "build": "npm run install:all && npm run build --prefix client",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
